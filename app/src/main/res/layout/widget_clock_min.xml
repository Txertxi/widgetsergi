<?xml version="1.0" encoding="utf-8"?>
<!-- Android < 12: sense busca de segons. La versió amb segons és a layout-v31. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/clock_dial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <AnalogClock
        android:id="@+id/clock_analog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dial="@drawable/clock_dial_empty"
        android:hand_hour="@drawable/hand_hour_min"
        android:hand_minute="@drawable/hand_minute_min" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/clock_cap_min" />
</FrameLayout>
